# Backend Environment Configuration Template

# Server Settings
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/ai-mystery-room
# Atlas MongoDB: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-mystery-room
# In-memory MongoDB: Set USE_IN_MEMORY_DB=true to run without installing or connecting to external MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
USE_IN_MEMORY_DB=false

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
# Get your API key at: https://aistudio.google.com/
# If left empty, the server automatically generates high-fidelity deterministic offline seed cases
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# Game Guardrails & Rate Limits
CASE_GENERATION_LIMIT_PER_HOUR=10

