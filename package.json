{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "description": "AI-generated fictional mystery investigation game powered by Google Gemini and MERN stack.",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:server": "npm run dev:backend",
    "dev:client": "npm run dev:frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:server": "npm run build:backend",
    "build:client": "npm run build:frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run start --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "test:server": "npm run test:backend",
    "test": "npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Antigravity",
  "license": "ISC"
}
