# AI Mystery Room — Root Environment Configuration Template

# Server Settings
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database configuration (MongoDB URI or in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
USE_IN_MEMORY_DB=false

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_investigation_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Google Gemini AI Provider
# Get key from https://aistudio.google.com/ (leave blank for offline simulated seed mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
CASE_GENERATION_LIMIT_PER_HOUR=10

# Frontend Configuration (when building/serving frontend)
VITE_API_BASE_URL=/api/v1
